{
  "proposals": ["http"],
  "world": "wasi:http/service",
  "servers": [
    { "name": "main", "endpoints": [
      { "method": "GET", "path": "/",
        "response": { "status": 200, "body": "root" } },
      { "method": "GET", "path": "/plain",
        "response": { "status": 200, "body": "plain" } },
      { "method": "GET", "path": "/query?x=1",
        "response": { "status": 200, "body": "query" } },
      { "method": "GET", "path": "/multi?a=1&b=2",
        "response": { "status": 200, "body": "multi" } },
      { "method": "GET", "path": "/pct%2Fsegment?q=a%20b",
        "response": { "status": 200, "body": "encoded" } },
      { "method": "GET", "path": "/echo?a=1&a=2&b=", "mode": "echo-headers" }
    ] }
  ],
  "operations": [
    { "type": "run" },
    { "type": "request",
      "method": "GET",
      "path": "/",
      "response": { "status": 200 } },
    { "type": "kill", "signal": "SIGINT" },
    { "type": "wait" }
  ]
}
