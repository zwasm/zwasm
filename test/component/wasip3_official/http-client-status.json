{
  "proposals": ["http"],
  "world": "wasi:http/service",
  "servers": [
    { "name": "main", "endpoints": [
      { "method": "GET", "path": "/ok",
        "response": { "status": 200 } },
      { "method": "GET", "path": "/created",
        "response": { "status": 201, "body": "made" } },
      { "method": "GET", "path": "/teapot",
        "response": { "status": 418 } },
      { "method": "GET", "path": "/boom",
        "response": { "status": 500, "body": "nope" } }
    ] }
  ],
  "operations": [
    { "type": "run" },
    { "type": "request",
      "method": "GET",
      "path": "/",
      "response": { "status": 200 } },
    { "type": "kill", "signal": "SIGINT" },
    { "type": "wait" }
  ]
}
