{
  "proposals": ["http"],
  "world": "wasi:http/service",
  "servers": [
    { "name": "main", "endpoints": [
      { "method": "GET", "path": "/chunked",
        "response": { "status": 200, "chunks": ["one", "two", "three"] } },
      { "method": "GET", "path": "/trailers",
        "response": { "status": 200, "chunks": ["pay", "load"],
                      "trailers": { "x-checksum": "abc123", "x-parts": "1" } } }
    ] }
  ],
  "operations": [
    { "type": "run" },
    { "type": "request",
      "method": "GET",
      "path": "/",
      "response": { "status": 200 } },
    { "type": "kill", "signal": "SIGINT" },
    { "type": "wait" }
  ]
}
