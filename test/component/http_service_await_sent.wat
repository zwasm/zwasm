;; A wasi:http 0.3 service whose handler returns its response, then awaits the
;; future `response.new` returned (#734). The body is "hello"; the handler
;; exits only once the future resolves `ok`, and traps if it resolves `err`.
(component
  (type $types (instance
    (export "response" (type (sub resource)))
    (type (option string))
    (type (option u16))
    (type (record (field "rcode" 1) (field "info-code" 2)))
    (export "DNS-error-payload" (type (eq 3)))
    (type (option u8))
    (type (record (field "alert-id" 5) (field "alert-message" 1)))
    (export "TLS-alert-received-payload" (type (eq 6)))
    (type (option u32))
    (type (record (field "field-name" 1) (field "field-size" 8)))
    (export "field-size-payload" (type (eq 9)))
    (type (option u64))
    (type (option 10))
    (type (variant (case "DNS-timeout") (case "DNS-error" 4) (case "destination-not-found") (case "destination-unavailable") (case "destination-IP-prohibited") (case "destination-IP-unroutable") (case "connection-refused") (case "connection-terminated") (case "connection-timeout") (case "connection-read-timeout") (case "connection-write-timeout") (case "connection-limit-reached") (case "TLS-protocol-error") (case "TLS-certificate-error") (case "TLS-alert-received" 7) (case "HTTP-request-denied") (case "HTTP-request-length-required") (case "HTTP-request-body-size" 11) (case "HTTP-request-method-invalid") (case "HTTP-request-URI-invalid") (case "HTTP-request-URI-too-long") (case "HTTP-request-header-section-size" 8) (case "HTTP-request-header-size" 12) (case "HTTP-request-trailer-section-size" 8) (case "HTTP-request-trailer-size" 10) (case "HTTP-response-incomplete") (case "HTTP-response-header-section-size" 8) (case "HTTP-response-header-size" 10) (case "HTTP-response-body-size" 11) (case "HTTP-response-trailer-section-size" 8) (case "HTTP-response-trailer-size" 10) (case "HTTP-response-transfer-coding" 1) (case "HTTP-response-content-coding" 1) (case "HTTP-response-timeout") (case "HTTP-upgrade-failed") (case "HTTP-protocol-error") (case "loop-detected") (case "configuration-error") (case "internal-error" 1)))
    (export "error-code" (type (eq 13)))
    (export "request" (type (sub resource)))
    (export "fields" (type (sub resource)))
    (export "headers" (type (eq 16)))
    (export "trailers" (type (eq 16)))
    (type (own 16))
    (type (func (result 19)))
    (export "[constructor]fields" (func (type 20)))
    (type (result (error 14)))
    (type (future 21))
    (type (stream u8))
    (type (own 18))
    (type (option 24))
    (type (result 25 (error 14)))
    (type (future 26))
    (type (option 23))
    (type (own 0))
    (type (tuple 29 22))
    (type (own 17))
    (type (func (param "headers" 31) (param "contents" 28) (param "trailers" 27) (result 30)))
    (export "[static]response.new" (func (type 32)))
  ))
  (import "wasi:http/types@0.3.0" (instance $http (type $types)))
  (alias export $http "request" (type $request))
  (alias export $http "response" (type $response))
  (alias export $http "error-code" (type $error-code))
  (alias export $http "trailers" (type $trailers))

  (type $sent (future (result (error $error-code))))
  (type $own-trailers (own $trailers))
  (type $trailers-future (future (result (option $own-trailers) (error $error-code))))
  (type $body (stream u8))
  (type $own-response (own $response))
  (type $handle-result (result $own-response (error $error-code)))
  (type $own-request (own $request))

  ;; Memory and a bump allocator; the heap starts at 4096.
  (core module $libc
    (memory (export "mem") 1)
    (global $next (mut i32) (i32.const 4096))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $p i32)
      (local.set $p (i32.and (i32.add (global.get $next) (i32.sub (local.get 2) (i32.const 1)))
                             (i32.sub (i32.const 0) (local.get 2))))
      (global.set $next (i32.add (local.get $p) (local.get 3)))
      (local.get $p)))
  (core instance $libc (instantiate $libc))

  (alias export $http "[constructor]fields" (func $fields-new-f))
  (alias export $http "[static]response.new" (func $response-new-f))
  (core func $fields-new (canon lower (func $fields-new-f)))
  (core func $response-new (canon lower (func $response-new-f) (memory (core memory $libc "mem"))))
  (core func $request-drop (canon resource.drop $request))
  (core func $trailers-new (canon future.new $trailers-future))
  (core func $trailers-drop-writable (canon future.drop-writable $trailers-future))
  (core func $sent-read (canon future.read $sent (memory (core memory $libc "mem")) (realloc (core func $libc "realloc")) async))
  (core func $sent-drop-readable (canon future.drop-readable $sent))
  (core func $body-new (canon stream.new $body))
  (core func $body-write (canon stream.write $body (memory (core memory $libc "mem")) async))
  (core func $body-drop-writable (canon stream.drop-writable $body))
  (core func $set-new (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $task-return (canon task.return (result $handle-result) (memory (core memory $libc "mem"))))

  ;; Memory: response.new's result at 0 (response @0, sent @4), the sent
  ;; future's value at 64, the body at 256.
  (core module $m
    (import "libc" "mem" (memory 1))
    (import "host" "fields-new" (func $fields-new (result i32)))
    (import "host" "response-new" (func $response-new (param i32 i32 i32 i32 i32)))
    (import "host" "request-drop" (func $request-drop (param i32)))
    (import "host" "trailers-new" (func $trailers-new (result i64)))
    (import "host" "trailers-drop-writable" (func $trailers-drop-writable (param i32)))
    (import "host" "sent-read" (func $sent-read (param i32 i32) (result i32)))
    (import "host" "sent-drop-readable" (func $sent-drop-readable (param i32)))
    (import "host" "body-new" (func $body-new (result i64)))
    (import "host" "body-write" (func $body-write (param i32 i32 i32) (result i32)))
    (import "host" "body-drop-writable" (func $body-drop-writable (param i32)))
    (import "host" "set-new" (func $set-new (result i32)))
    (import "host" "join" (func $join (param i32 i32)))
    (import "host" "task-return" (func $task-return (param i32 i32 i32 i64 i32 i32 i32 i32)))
    (data (i32.const 256) "hello")
    (global $sent (mut i32) (i32.const 0))
    (global $body-w (mut i32) (i32.const 0))
    (global $trailers-w (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))

    (func $wait (result i32)
      (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))

    (func (export "handle") (param $request i32) (result i32)
      (local $body i64)
      (local $trailers i64)
      (call $request-drop (local.get $request))
      (local.set $body (call $body-new))
      (global.set $body-w (i32.wrap_i64 (i64.shr_u (local.get $body) (i64.const 32))))
      (local.set $trailers (call $trailers-new))
      (global.set $trailers-w (i32.wrap_i64 (i64.shr_u (local.get $trailers) (i64.const 32))))
      (call $response-new (call $fields-new)
        (i32.const 1) (i32.wrap_i64 (local.get $body))
        (i32.wrap_i64 (local.get $trailers))
        (i32.const 0))
      (global.set $sent (i32.load (i32.const 4)))
      (call $task-return (i32.const 0) (i32.load (i32.const 0)) (i32.const 0) (i64.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
      (global.set $set (call $set-new))
      ;; No reader yet: the write parks until the host takes the body in.
      (if (i32.eq (call $body-write (global.get $body-w) (i32.const 256) (i32.const 5)) (i32.const -1))
        (then (call $join (global.get $body-w) (global.get $set)))
        (else (call $body-drop-writable (global.get $body-w))))
      (if (i32.ne (call $sent-read (global.get $sent) (i32.const 64)) (i32.const -1))
        (then unreachable))
      (call $join (global.get $sent) (global.get $set))
      (call $wait))

    (func (export "callback") (param $event i32) (param $handle i32) (param $payload i32) (result i32)
      ;; stream-write: the body is out; closing it completes the response.
      (if (i32.eq (local.get $event) (i32.const 3))
        (then
          (call $body-drop-writable (global.get $body-w))
          (return (call $wait))))
      (if (i32.ne (local.get $event) (i32.const 4)) (then unreachable))
      ;; future-read: the response went out ok.
      (if (i32.load8_u (i32.const 64)) (then unreachable))
      (call $sent-drop-readable (global.get $sent))
      ;; The host dropped the trailers reader when it took the response in.
      (call $trailers-drop-writable (global.get $trailers-w))
      (i32.const 0)))

  (core instance $host
    (export "fields-new" (func $fields-new))
    (export "response-new" (func $response-new))
    (export "request-drop" (func $request-drop))
    (export "trailers-new" (func $trailers-new))
    (export "trailers-drop-writable" (func $trailers-drop-writable))
    (export "sent-read" (func $sent-read))
    (export "sent-drop-readable" (func $sent-drop-readable))
    (export "body-new" (func $body-new))
    (export "body-write" (func $body-write))
    (export "body-drop-writable" (func $body-drop-writable))
    (export "set-new" (func $set-new))
    (export "join" (func $join))
    (export "task-return" (func $task-return)))
  (core instance $i (instantiate $m
    (with "libc" (instance $libc))
    (with "host" (instance $host))))

  (alias core export $i "handle" (core func $handle-core))
  (alias core export $i "callback" (core func $callback-core))
  (func $handle async (param "request" $own-request) (result $handle-result)
    (canon lift (core func $handle-core) (memory (core memory $libc "mem")) async (callback $callback-core)))
  (instance $handler (export "handle" (func $handle)))
  (export "wasi:http/handler@0.3.0" (instance $handler))
)
