;; #745 — `throw_ref` of a null exnref traps null_reference, whatever clause
;; surrounds it: none, `catch_all`, `catch_all_ref`, or a `catch` / `catch_ref`
;; naming a tag this function has already thrown and caught (an i32 and a
;; funcref payload).
;; Built with `wasm-tools parse`; the committed .wasm is this text.
(module
  (tag $ti (param i32))
  (tag $tf (param funcref))
  (func $g)
  (elem declare func $g)
  (func (export "plain") (result i32)
    (throw_ref (ref.null exn)))
  (func (export "catch_all") (result i32)
    (block $h (try_table (catch_all $h) (throw_ref (ref.null exn))))
    (i32.const 5))
  (func (export "catch_all_ref") (result i32)
    (block $h (result exnref)
      (try_table (catch_all_ref $h) (throw_ref (ref.null exn)))
      (return (i32.const 9)))
    (ref.is_null))
  (func (export "catch_tag_i32") (result i32)
    (block $a (result i32)
      (try_table (catch $ti $a) (throw $ti (i32.const 5)))
      (unreachable))
    (drop)
    (block $out (result i32)
      (try_table (catch $ti $out) (throw_ref (ref.null exn)))
      (i32.const 7)))
  (func (export "catch_tag_funcref") (result i32)
    (block $a (result funcref)
      (try_table (catch $tf $a) (throw $tf (ref.func $g)))
      (unreachable))
    (drop)
    (block $out (result funcref)
      (try_table (catch $tf $out) (throw_ref (ref.null exn)))
      (return (i32.const 7)))
    (ref.is_null))
  (func (export "catch_ref_tag_i32") (result i32)
    (block $a (result i32 exnref)
      (try_table (catch_ref $ti $a) (throw $ti (i32.const 5)))
      (unreachable))
    (drop) (drop)
    (block $out (result i32 exnref)
      (try_table (catch_ref $ti $out) (throw_ref (ref.null exn)))
      (return (i32.const 7)))
    (drop)))
